@using Biblioteca.Areas.Administration.ViewModels.Atualizar
@model AtualizarObraViewModel

@{
    ViewData["Titulo"] = "Atualizar obra literária";
}

<h2>Atualizar obra literária</h2>
<hr />

<div class="container">

    @if (ViewData["Sucesso"] is not null)
    {
        <div class="alert alert-success">
            @ViewData["Sucesso"]
        </div>
    }

    @if (ViewData["Falha"] is not null)
    {
        <div class="alert alert-danger">
            @ViewData["Falha"]
        </div>
    }

    @if (Model is not null && Model.ObrasLiterarias is not null && Model.ObrasLiterarias.Count() > 0)
    {
        <form asp-controller="Emprestimo" asp-action="AtualizarEmprestimo" method="post" role="form">

            <input hidden asp-for="ObrasLiterarias" value="@Model.ObrasLiterarias" />

            <div class="form-group">
                <fieldset>
                    <label asp-for="Id">Escolha a obra literária que deseja editar: </label>
                    <select class="form-select" asp-for="Id">
                        @foreach (ObraLiteraria obra in Model.ObrasLiterarias)
                        {
                            <option value="@obra.Id">@(obra.Titulo)</option>
                        }
                    </select>
                </fieldset>
            </div>

            <br />

            <div class="form-group">
                <fieldset>
                    <label asp-for="CategoriaId">Escolha a categoria que esta obra literária atende: </label>
                    <select asp-for="CategoriaId">
                        @foreach (Categoria categoria in Model.CategoriasExistentes)
                        {
                            <option value="@categoria.Id">@(categoria.Titulo)</option>
                        }
                    </select>
                </fieldset>
            </div>

            <br />

            <div class="form-group">
                <label asp-for="Titulo">Novo título da obra: </label>
                <input asp-for="Titulo" type="text"/>
                <span asp-validation-for="Titulo"></span>
            </div>

            <br />

            <div class="form-group">
                <label asp-for="ISBN">ISBN: </label>
                <input asp-for="ISBN" type="text" />
                <span asp-validation-for="ISBN"></span>
            </div>

            <br />

            <div class="form-group">
                <label asp-for="AnoPublicacao">Ano de publicação: </label>
                <input asp-for="AnoPublicacao" type="number" />
                <span asp-validation-for="AnoPublicacao"></span>
            </div>

            <br />

            <div class="form-group">
                <fieldset>
                    <label asp-for="EditoraId">Escolha a editora que publicou esta obra literária: </label>
                    <select asp-for="EditoraId">
                        @foreach (Editora editora in Model.EditorasExistentes)
                        {
                            <option value="@editora.Id">@(editora.Nome)</option>
                        }
                    </select>
                </fieldset>
            </div>

            <br />

            <div class="form-group">
                <label>Autores: </label>
                <fieldset>

                    @foreach (Autor autor in Model.AutoresExistentes)
                    {
                        <input name="AutoresSelecionados" value="@autor.Id" type="checkbox" />
                        <label>@(autor.PrimeiroNome + " " + @autor.Sobrenome)</label>
                        <br />
                    }

                </fieldset>
                <span asp-validation-for="Autores"></span>
            </div>

            <br />

            <div class="form-group">
                <label asp-for="FotoCapa">Link da foto da capa: </label>
                <input asp-for="FotoCapa" type="url"/>
                <span asp-validation-for="FotoCapa"></span>
            </div>

            <div class="form-group">
                <br />
                <input class="btn btn-primary" type="submit" value="Atualizar" />
            </div>
        </form>
    }
    else
    {
        <h4>Não é possível atualizar uma obra literária porque não há registros de obras literárias.</h4>
    }
</div>


<br />
<a class="btn btn-outline-dark" asp-area="Administration" asp-controller="Home" asp-action="Atualizar">Voltar</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}