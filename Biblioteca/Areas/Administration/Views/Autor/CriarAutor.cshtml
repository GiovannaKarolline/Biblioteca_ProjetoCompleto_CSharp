@model AutorViewModel

@{
    ViewData["Titulo"] = "Criar autor";
}

<h2>Criar autor</h2>
<hr />

<div class="container">

    <partial name="_AvisosPartial" />

    <form asp-controller="Autor" asp-action="CriarAutor" method="post" role="form">
        <div class="form-group">
            <label asp-for="PrimeiroNome">Primeiro nome do autor</label>
            <input class="form-control" type="text" placeholder="Primeiro nome" asp-for="PrimeiroNome" />
            <span asp-validation-for="PrimeiroNome"></span>
        </div>

        <br />

        <div class="form-group">
            <label asp-for="Sobrenome">Sobrenome do autor</label>
            <input class="form-control" type="text" placeholder="Sobrenome" asp-for="Sobrenome" />
            <span asp-validation-for="Sobrenome"></span>
        </div>
        <div class="form-group">
            <br />
            <input class="btn btn-primary" type="submit" value="Criar" />
        </div>
    </form>
</div>

<br />
<a class="btn btn-outline-dark" asp-area="Administration" asp-controller="Home" asp-action="Criar">Voltar</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}