@model AtualizarAutorViewModel

@{
    ViewData["Titulo"] = "Atualizar autor";
}

<h2>Atualizar autor</h2>
<hr />

<div class="container">

    @if (ViewData["Sucesso"] is not null)
    {
        <div class="alert alert-success">
            @ViewData["Sucesso"]
        </div>
    }

    @if (ViewData["Falha"] is not null)
    {
        <div class="alert alert-danger">
            @ViewData["Falha"]
        </div>
    }

    @if(Model.Autores is not null)
    {
        <form asp-controller="Autor" asp-action="AtualizarAutor" method="post" role="form">

            <input hidden asp-for="Autores" value="@Model.Autores"/>

            <fieldset>
                <label asp-for="Id">Escolha um autor para editar: </label>
                <select asp-for="Id">
                    @foreach (Autor autor in Model.Autores)
                    {
                        <option value="@autor.Id">@(autor.PrimeiroNome + " " + autor.Sobrenome)</option>
                    }
                </select>
            </fieldset>

            <div class="form-group">
                <label asp-for="PrimeiroNome">Digite o novo primeiro nome do autor: </label>
                <input type="text" placeholder="Primeiro nome" asp-for="PrimeiroNome" />
                <span asp-validation-for="PrimeiroNome"></span>
            </div>
            <div class="form-group">
                <label asp-for="Sobrenome">Digite o novo sobrenome do autor: </label>
                <input type="text" placeholder="Sobrenome" asp-for="Sobrenome" />
                <span asp-validation-for="Sobrenome"></span>
            </div>
            <div class="form-group">
                <input type="submit" placeholder="Atualizar" />
            </div>
        </form>
    }
    else
    {
        <h4>Não é possível atualizar um autor porque não há registros de autores.</h4>
    }
</div>


<br />
<a class="btn btn-outline-dark" asp-area="Administration" asp-controller="Home" asp-action="Atualizar">Voltar</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}