@using Biblioteca.Areas.Administration.ViewModels.Deletar
@model DeletarAutorViewModel

@{
    ViewData["Title"] = "Deletar autor";
}

<h2>Deletar autor</h2>

<div class="container">

    @if (ViewData["Sucesso"] is not null)
    {
        <div class="alert alert-success">
            @ViewData["Sucesso"]
        </div>
    }

    @if (ViewData["Falha"] is not null)
    {
        <div class="alert alert-danger">
            @ViewData["Falha"]
        </div>
    }

    @if (Model is not null && Model.Autores is not null && Model.Autores.Count() > 0)
    {
        <form asp-area="Administration" asp-controller="Autor" asp-action="DeletarAutor" method="post" role="form">
            <div class="form-group">
            <label>Escolha o autor:</label>
                <select class="form-select" asp-for="Id">
                    @foreach (Autor autor in Model.Autores)
                    {
                        <option value="@autor.Id">@(autor.PrimeiroNome + " " + autor.Sobrenome)</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <br />
                <input class="btn btn-primary" type="submit" value="Deletar" />
            </div>
        </form>
    }
    else
    {
        <h4>Não há autores para deletar.</h4>
    }

    <br />
    <a class="btn btn-outline-dark" asp-area="Administration" asp-controller="Home" asp-action="Deletar">Voltar</a>
    
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}