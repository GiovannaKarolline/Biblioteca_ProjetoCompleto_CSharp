@model DeletarAutorViewModel

@{
    ViewData["Title"] = "Deletar autor";
}

<h2>Deletar autor</h2>

<div class="container">

    @if(Model.Autores is not null)
    {
        <form asp-area="Administration" asp-controller="Autor" asp-action="DeletarAutor" method="post" role="form">
            <div class="form-group">
            <label>Escolha o autor:</label>
                <select asp-for="Id">
                    @foreach (Autor autor in Model.Autores)
                    {
                        <option value="@autor.Id">@(autor.PrimeiroNome + " " + autor.Sobrenome)</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <input type="submit" placeholder="Deletar" />
            </div>
        </form>

        <br />
        <a class="btn btn-outline-dark" asp-area="Administration" asp-controller="Home" asp-action="Deletar">Voltar</a>
    }
    else
    {
        <h4>Não há autores para deletar.</h4>
    }
    
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}