@using Biblioteca.Areas.Administration.ViewModels.Deletar
@model DeletarCategoriaViewModel

@{
    ViewData["Title"] = "Deletar categoria";
}

<h2>Deletar categoria</h2>

<div class="container">

    @if (ViewData["Sucesso"] is not null)
    {
        <div class="alert alert-success">
            @ViewData["Sucesso"]
        </div>
    }

    @if (ViewData["Falha"] is not null)
    {
        <div class="alert alert-danger">
            @ViewData["Falha"]
        </div>
    }

    @if (Model is not null && Model.Categorias is not null && Model.Categorias.Count() > 0)
    {
        <form asp-area="Administration" asp-controller="Categoria" asp-action="DeletarCategoria" method="post" role="form">
            <div class="form-group">
                <label>Escolha o autor:</label>
                <select class="form-select" asp-for="Id">
                    @foreach (Categoria categoria in Model.Categorias)
                    {
                        <option value="@categoria.Id">@(categoria.Titulo)</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <br />
                <input class="btn btn-primary" type="submit" value="Deletar" />
            </div>
        </form>
    }
    else
    {
        <h4>Não há categorias para deletar.</h4>
    }

    <br />
    <a class="btn btn-outline-dark" asp-area="Administration" asp-controller="Home" asp-action="Deletar">Voltar</a>

</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}