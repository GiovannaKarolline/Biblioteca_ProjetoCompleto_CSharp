@using Biblioteca.Areas.Administration.ViewModels.Atualizar
@model AtualizarCategoriaViewModel

@{
    ViewData["Titulo"] = "Atualizar categoria";
}

<h2>Atualizar categoria</h2>
<hr />

<div class="container">

    <partial name="_AvisosPartial" />

    @if (Model is not null && Model.Categorias is not null)
    {
        <form asp-controller="Categoria" asp-action="AtualizarCategoria" method="post" role="form">

            <input hidden asp-for="Categorias" value="@Model.Categorias" />

            <fieldset>
                <label asp-for="Id">Escolha uma categoria para editar: </label>
                <select class="form-select" asp-for="Id">
                    @foreach (Categoria categoria in Model.Categorias)
                    {
                        <option value="@categoria.Id">@(categoria.Titulo)</option>
                    }
                </select>
            </fieldset>

            <br />

            <div class="form-group">
                <label asp-for="Titulo">Digite o novo título da categoria: </label>
                <input class="form-control" type="text" placeholder="Título" asp-for="Titulo" />
                <span asp-validation-for="Titulo"></span>
            </div>
            <div class="form-group">
                <br />
                <input class="btn btn-primary" type="submit" value="Atualizar" />
            </div>
        </form>
    }
    else
    {
        <h4>Não é possível atualizar uma categoria porque não há registros de categorias.</h4>
    }
</div>


<br />
<a class="btn btn-outline-dark" asp-area="Administration" asp-controller="Home" asp-action="Atualizar">Voltar</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}