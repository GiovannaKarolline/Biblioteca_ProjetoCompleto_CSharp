@model CategoriaViewModel

@{
    ViewData["Title"] = "Criar categoria";
}

<h2>Criar categoria</h2>
<hr />

<div class="container">

    @if(ViewData["Sucesso"] is not null)
    {
        <div class="alert alert-success">
            @ViewData["Sucesso"]
        </div>
    }

    @if (ViewData["Falha"] is not null)
    {
        <div class="alert alert-danger">
            @ViewData["Falha"]
        </div>
    }

    <form asp-controller="Categoria" asp-action="CriarCategoria" method="post" role="form">
        <div class="form-group">
            <label asp-for="Titulo">Título da categoria</label>
            <input class="form-control" type="text" placeholder="Título" asp-for="Titulo" />
            <span asp-validation-for="Titulo"></span>
        </div>

        <div class="form-group">
            <br />
            <input class="btn btn-primary" type="submit" value="Criar" />
        </div>
    </form>
</div>

<br />
<a class="btn btn-outline-dark" asp-area="Administration" asp-controller="Home" asp-action="Criar">Voltar</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}