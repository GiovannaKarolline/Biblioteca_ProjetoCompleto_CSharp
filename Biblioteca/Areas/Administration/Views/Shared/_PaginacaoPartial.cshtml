@using X.PagedList

@model IPagedList

<div class="paginacao">
    <nav aria-label="páginas" class="">
        <ul class="pagination">

            @if (Model.PageNumber > 1)
            {
                <li class="page-item"><a asp-action="Index" asp-route-paginaAtual="@(Model.PageNumber - 1)" class="page-link">Anterior</a></li>
            }
            else
            {
                <li class="page-item"><a class="btn page-link disabled">Anterior</a></li>
            }

            @for (int i = 0; i < Model.PageCount; i++)
            {
                <li class="page-item"><a class="page-link" asp-action="Index" asp-route-paginaAtual="@(i + 1)">@(i + 1)</a></li>
            }

            @if (Model.PageNumber != Model.PageCount)
            {
                <li class="page-item"><a class="page-link" asp-action="Index" asp-route-paginaAtual="@(Model.PageNumber + 1)">Próxima</a></li>
            }
            else
            {
                <li class="page-item"><a class="btn page-link disabled">Próxima</a></li>
            }

        </ul>
    </nav>
</div>