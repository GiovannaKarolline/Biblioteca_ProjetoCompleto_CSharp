@model IEnumerable<Object>

@if (@Model.FirstOrDefault() is not null)
{
    <h2 class="text-center">Lista de registros do tipo @Model.FirstOrDefault().GetType().Name</h2>
    <hr />
    <br />

    @foreach(Object item in Model)
    {
        <div class="listar-container">
             <h4 style="white-space: pre-line;">@item.ToString()</h4>
        </div>
    }
}
else
{
    <h2><strong>Lista nula:</strong> não é possível listar</h2>
}