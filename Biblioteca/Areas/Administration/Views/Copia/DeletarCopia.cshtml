@using Biblioteca.Areas.Administration.ViewModels.Deletar
@model DeletarCopiaViewModel

@{
    ViewData["Titulo"] = "Deletar cópia";
}

<h2>Deletar cópia</h2>
<hr />

<div class="container">

    <partial name="_AvisosPartial" />

    @if (Model is not null && Model.Copias is not null)
    {
        <form asp-controller="Copia" asp-action="DeletarCopia" method="post" role="form">

            <input hidden asp-for="Copias" value="@Model.Copias" />

            <div class="form-group">
                <fieldset>
                    <label asp-for="Id">Escolha uma cópia para deletar: </label>
                    <select class="form-select" asp-for="Id">
                        @foreach (Copia copia in Model.Copias)
                        {
                            <option value="@copia.Id">@(copia.ToString())</option>
                        }
                    </select>
                </fieldset>
            </div>

            <div class="form-group">
                <br />
                <input class="btn btn-primary" type="submit" value="Deletar" />
            </div>
        </form>
    }
    else
    {
        <h4>Não é possível deletar uma cópia porque não há registros de cópias.</h4>
    }
</div>


<br />
<a class="btn btn-outline-dark" asp-area="Administration" asp-controller="Home" asp-action="Deletar">Voltar</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}