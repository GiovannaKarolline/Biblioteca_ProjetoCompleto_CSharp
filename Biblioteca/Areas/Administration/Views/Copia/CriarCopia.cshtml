@using Biblioteca.Areas.Administration.ViewModels.Criar
@using Biblioteca.ViewModels

@model CriarCopiaViewModel

@{
    ViewData["Title"] = "Criar cópia";
}

<h2>Criar cópia</h2>
<hr />

<div class="container">

    <partial name="_AvisosPartial" />

    @if(Model.ObrasPossiveis is not null && Model.ObrasPossiveis.Count() > 0)
    {
        <form asp-controller="Copia" asp-action="CriarCopia" method="post" role="form">
            <div class="form-group">
                <fieldset>
                    <label asp-for="ObraId">Escolha a obra a ser representada pela cópia: </label>
                    <select class="form-select" asp-for="ObraId">
                        @foreach (ObraLiteraria obra in Model.ObrasPossiveis)
                        {
                            <option value="@obra.Id">@(obra.Titulo)</option>
                        }
                    </select>
                </fieldset>

                <div class="form-group form-check">
                    <br />

                    <p>A cópia está disponível para empréstimo?</p>

                    <label class="form-check-label" asp-for="StatusDisponibilidade">Sim</label>
                    <input class="form-check-input" asp-for="StatusDisponibilidade" type="radio" value="@true" />

                    <br />

                    <label class="form-check-label" asp-for="StatusDisponibilidade">Não</label>
                    <input class="form-check-input" asp-for="StatusDisponibilidade"  type="radio" value="@false" />
                </div>

            </div>
        
            <div class="form-group">
                <br />
                <input class="btn btn-primary" type="submit" value="Criar" />
            </div>
        </form>
    }
    else
    {
        <h4>Não existe uma obra literária para que uma cópia dela seja criada.</h4>
    }
</div>

<br />
<a class="btn btn-outline-dark" asp-area="Administration" asp-controller="Home" asp-action="Criar">Voltar</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}