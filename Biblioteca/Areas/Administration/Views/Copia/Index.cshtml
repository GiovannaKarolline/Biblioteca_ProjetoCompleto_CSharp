@using Biblioteca.ViewModels
@model CopiaViewModel

@{
    ViewData["Title"] = "Cópias";
}

<partial name="_AvisosPartial" />

<h2>Cópias</h2>
<hr />
<br />

@if (Model is null || Model.Copias is null || Model.Copias.Count() < 1)
{
    <h4>Não há registros de cópias disponíveis para edição.</h4>
}
else
{
    @if (Model.ObrasLiterarias is null || Model.ObrasLiterarias.Count() < 1)
    {
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#criar" disabled>+ Adicionar nova cópia</button>
    }
    else
    {
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#criar">+ Adicionar nova cópia</button>
    }

    <br />

    <div class="modal fade" id="criar" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content card">
                <div class="modal-body">
                    <form asp-area="Administration" asp-controller="Copia" asp-action="CriarCopia" method="post">

                        <div class="modal-header">
                            <h1 class="modal-title fs-5">Adicionar nova cópia</h1>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cancelar"></button>
                        </div>

                        <br />

                        @if (Model.ObrasLiterarias is not null)
                        {
                            <label asp-for="ObraId">Obra literária representada</label>
                            <select asp-for="ObraId" asp-items="@(new SelectList(Model.ObrasLiterarias, "Id", "Titulo"))" class="form-select" placeholder="Quem esta cópia referencia?">
                            </select>
                            <span asp-validation-for="ObraId"></span>

                            <br />
                        }

                        <label asp-for="StatusDisponibilidade">Status de Disponibilidade</label>
                        <select asp-for="StatusDisponibilidade" class="form-select" placeholder="Esta cópia pode ser emprestada??">
                            
                            <option value="@true">Sim</option>

                            <option value="@false">Não</option>

                        </select>
                        <span asp-validation-for="ObraId"></span>

                        <br />

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-primary">Adicionar</button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>


    <div class="tabela_listar">

        <table class="table table-responsive text-center">

            <tr class="d-table-row">
                <th>Id</th>
                <th>Obra Referenciada</th>
                <th>Status de Disponibilidade</th>
            </tr>

            @foreach (Copia copia in Model.Copias)
            {
                <tr>
                    <td>@copia.Id</td>
                    <td>@copia.ObraLiteraria.Titulo</td>
                    <td>@(copia.StatusDisponibilidade.ToString() == "False" ? "Emprestado" : "Disponível")</td>
                    <td>
                        <div class="d-inline-flex justify-content-between">
                            <button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#atualizar-@copia.Id">Atualizar</button>

                            <div class="modal fade" id="atualizar-@copia.Id" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content card">
                                        <div class="modal-header">
                                            <h1 class="modal-title fs-5" id="staticBackdropLabel">Atualizar cópia</h1>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cancelar"></button>
                                        </div>

                                        <form class="text-start" asp-area="Administration" asp-controller="Copia" asp-action="AtualizarCopia" method="post">

                                            <div class="modal-body">

                                                <input hidden asp-for="Id" value="@copia.Id" />

                                                <br />

                                                @if (Model.ObrasLiterarias is not null)
                                                {
                                                    <label asp-for="ObraId">Obra literária representada</label>
                                                    <select asp-for="ObraId" asp-items="@(new SelectList(Model.ObrasLiterarias, "Id", "Titulo"))" class="form-select" placeholder="Quem esta cópia referencia?">
                                                    </select>
                                                    <span asp-validation-for="ObraId"></span>

                                                    <br />
                                                }

                                                <label asp-for="StatusDisponibilidade">Status de Disponibilidade</label>
                                                <select asp-for="StatusDisponibilidade" class="form-select" placeholder="Esta cópia pode ser emprestada??">

                                                    <option value="@true">Disponível</option>

                                                    <option value="@false">Emprestado</option>

                                                </select>
                                                <span asp-validation-for="ObraId"></span>

                                                <br />

                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                    <button type="submit" class="btn btn-primary">Atualizar</button>
                                                </div>

                                            </div>

                                        </form>
                                    </div>
                                </div>
                            </div>

                            <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deletar-@copia.Id">Deletar</button>

                            <div class="modal fade" id="deletar-@copia.Id" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content card">

                                        <div class="modal-header">
                                            <h1 class="modal-title fs-5" id="staticBackdropLabel">Deletar cópia</h1>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cancelar"></button>
                                        </div>

                                        <div class="modal-body">

                                            <form class="text-start" asp-area="Administration" asp-controller="Copia" asp-action="DeletarCopia" method="post">

                                                <input hidden asp-for="Id" value="@copia.Id" />

                                                <br />

                                                <label>Obra literária representada</label>
                                                <input class="form-control" value="@copia.ObraLiteraria.Titulo" disabled />

                                                <br />

                                                <label>Status de Disponibilidade</label>
                                                <input class="form-control" value="@(copia.StatusDisponibilidade.ToString() == "False" ? "Emprestado" : "Disponível")" disabled />

                                                <br />

                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                    <button type="submit" class="btn btn-primary">Deletar</button>
                                                </div>

                                            </form>

                                        </div>

                                    </div>
                                </div>
                            </div>

                        </div>
                    </td>
                </tr>
            }
        </table>

    </div>

    <partial name="_PaginacaoPartial" model="@Model.Copias"></partial>

}