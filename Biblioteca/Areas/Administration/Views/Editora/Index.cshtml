@using Biblioteca.ViewModels
@model EditoraViewModel

@{
    ViewData["Title"] = "Editoras";
}

<partial name="_AvisosPartial" />

<h2>Editoras</h2>
<hr />
<br />

@if (Model is null || Model.Editoras is null || Model.Editoras.Count() < 1)
{
    <h4>Não há registros de editoras disponíveis para edição.</h4>
}
else
{
    
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#criar">+ Adicionar nova editora</button>

    <br />

    <div class="modal fade" id="criar" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content card">
                <div class="modal-body">
                    <form asp-area="Administration" asp-controller="Editora" asp-action="CriarEditora" method="post">

                        <div class="modal-header">
                            <h1 class="modal-title fs-5">Adicionar nova editora</h1>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cancelar"></button>
                        </div>

                        <br />

                        <label asp-for="Nome">Nome</label>
                        <input asp-for="Nome" class="form-control" placeholder="Nome da editora" />
                        <span asp-validation-for="Nome"></span>

                        <br />

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-primary">Adicionar</button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>


    <div class="tabela_listar">

        <table class="table table-responsive text-center">
            <tr class="d-table-row">
                <th>Id</th>
                <th>Nome da Editora</th>
            </tr>

            @foreach (Editora editora in Model.Editoras)
            {
                <tr>
                    <td>@editora.Id</td>
                    <td>@editora.Nome</td>
                    <td>
                        <div class="d-inline-flex justify-content-between">
                            <button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#atualizar-@editora.Id">Atualizar</button>

                            <div class="modal fade" id="atualizar-@editora.Id" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content card">
                                        <div class="modal-header">
                                            <h1 class="modal-title fs-5" id="staticBackdropLabel">Atualizar editora</h1>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cancelar"></button>
                                        </div>

                                        <form class="text-start" asp-area="Administration" asp-controller="Editora" asp-action="AtualizarEditora" method="post">

                                            <div class="modal-body">

                                                <input hidden asp-for="Id" value="@editora.Id" />

                                                <br />

                                                <label asp-for="Nome">Nome</label>
                                                <input asp-for="Nome" class="form-control" placeholder="Nome da editora" value="@editora.Nome"/>
                                                <span asp-validation-for="Nome"></span>

                                                <br />

                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                    <button type="submit" class="btn btn-primary">Atualizar</button>
                                                </div>

                                            </div>

                                        </form>
                                    </div>
                                </div>
                            </div>

                            <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deletar-@editora.Id">Deletar</button>

                            <div class="modal fade" id="deletar-@editora.Id" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content card">

                                        <div class="modal-header">
                                            <h1 class="modal-title fs-5" id="staticBackdropLabel">Deletar editora</h1>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cancelar"></button>
                                        </div>

                                        <div class="modal-body">

                                            <form class="text-start" asp-area="Administration" asp-controller="Editora" asp-action="DeletarEditora" method="post">

                                                <input hidden asp-for="Id" value="@editora.Id" />

                                                <br />

                                                <label>Nome</label>
                                                <input class="form-control" value="@editora.Nome" disabled>

                                                <br />

                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                    <button type="submit" class="btn btn-primary">Deletar</button>
                                                </div>

                                            </form>

                                        </div>

                                    </div>
                                </div>
                            </div>

                        </div>
                    </td>
                </tr>
            }
        </table>

    </div>

    <partial name="_PaginacaoPartial" model="@Model.Editoras"></partial>

}