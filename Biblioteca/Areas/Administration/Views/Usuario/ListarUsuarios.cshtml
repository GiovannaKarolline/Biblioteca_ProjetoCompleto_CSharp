@model IEnumerable<Usuario>

@{
    ViewData["Title"] = "Listar usuários";
}

<partial name="_AvisosPartial" />

<a class="btn btn-outline-dark" asp-area="Administration" asp-controller="Home" asp-action="Listar">Voltar</a>
<br />
<br />

@if (Model is not null && Model.Count() > 0)
{
    <partial name="_ListarPartial" model="@Model"></partial>
}
else
{
    <h4>Não há usuários para listar.</h4>
}