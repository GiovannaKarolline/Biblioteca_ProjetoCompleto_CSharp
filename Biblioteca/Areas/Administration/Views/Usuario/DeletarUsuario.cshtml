@using Biblioteca.Areas.Administration.ViewModels.Deletar
@model DeletarObraViewModel

@{
    ViewData["Titulo"] = "Deletar usuário";
}

<h2>Deletar usuário</h2>
<hr />

<div class="container">

    <partial name="_AvisosPartial" />

    @if (Model is not null && Model.ObrasLiterarias is not null)
    {
        <form asp-controller="ObraLiteraria" asp-action="DeletarObra" method="post" role="form">

            <input hidden asp-for="ObrasLiterarias" value="@Model.ObrasLiterarias" />

            <div class="form-group">
                <fieldset>
                    <label asp-for="Id">Escolha qual obra literária você deseja deletar: </label>
                    <select class="form-select" asp-for="Id">
                        @foreach (ObraLiteraria obra in Model.ObrasLiterarias)
                        {
                            <option value="@obra.Id">@(obra.Titulo + " - Id: " + obra.Id)</option>
                        }
                    </select>
                </fieldset>
            </div>

            <br />

            <div class="form-group">
                <br />
                <input class="btn btn-primary" type="submit" value="Deletar" />
            </div>
        </form>
    }
    else
    {
        <h4>Não é possível deletar uma obra literária porque não há registros de obras literárias.</h4>
    }
</div>


<br />
<a class="btn btn-outline-dark" asp-area="Administration" asp-controller="Home" asp-action="Deletar">Voltar</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}