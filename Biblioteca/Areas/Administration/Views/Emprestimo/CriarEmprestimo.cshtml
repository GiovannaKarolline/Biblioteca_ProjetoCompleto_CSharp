@using Biblioteca.Areas.Administration.ViewModels.Criar
@model CriarEmprestimoViewModel

@{
    ViewData["Title"] = "Criar empréstimo";
}

<h2>Criar empréstimos</h2>
<hr />

<div class="container">

    <partial name="_AvisosPartial" />

    @if (Model.CopiasExistentes is not null && Model.CopiasExistentes.Count() > 0)
    {
        <form asp-controller="Copia" asp-action="CriarCopia" method="post" role="form">

            <div class="form-group">

                <label>Escolha quais cópias serão inclusas: </label>
                <fieldset>

                    @foreach (Copia copia in Model.CopiasExistentes.Where(copia => copia.StatusDisponibilidade == true))
                    {
                        <input class="form-check-input" name="idCopias" value="@copia.Id" type="checkbox" />
                        <label class="form-check-label">@(copia.ObraLiteraria.Titulo + " " + @copia.Id)</label>
                        <br />
                    }

                </fieldset>

                <span asp-validation-for="idCopias"></span>

            </div>

            <div class="form-group">
                <br />
                <input class="btn btn-primary" type="submit" value="Criar" />
            </div>

        </form>
    }
    else
    {
        <h4>Não existe uma cópia para que um empréstimo seja criado.</h4>
    }
</div>

<br />
<a class="btn btn-outline-dark" asp-area="Administration" asp-controller="Home" asp-action="Criar">Voltar</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}