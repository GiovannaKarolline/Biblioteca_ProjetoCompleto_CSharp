@using Biblioteca.Areas.Administration.ViewModels.Deletar
@model DeletarEmprestimoViewModel

@{
    ViewData["Titulo"] = "Deletar cópia";
}

<h2>Deletar empréstimo</h2>
<hr />

<div class="container">

    @if (ViewData["Sucesso"] is not null)
    {
        <div class="alert alert-success">
            @ViewData["Sucesso"]
        </div>
    }

    @if (ViewData["Falha"] is not null)
    {
        <div class="alert alert-danger">
            @ViewData["Falha"]
        </div>
    }

    @if (Model is not null && Model.Copias is not null)
    {
        <form asp-controller="Emprestimo" asp-action="DeletarEmprestimo" method="post" role="form">

            <div class="form-group">
                <fieldset>
                    <label asp-for="Id">Escolha qual empréstimo deseja deletar: </label>
                    <select class="form-select" asp-for="Id">
                        @foreach (Emprestimo emprestimo in Model.Emprestimos)
                        {
                            <option value="@emprestimo.Id">@(emprestimo.ToString())</option>
                        }
                    </select>
                </fieldset>
            </div>

            <div class="form-group">
                <br />
                <input class="btn btn-primary" type="submit" value="Deletar" />
            </div>
        </form>
    }
    else
    {
        <h4>Não é possível deletar um empréstimo porque não há registros de empréstimos.</h4>
    }
</div>


<br />
<a class="btn btn-outline-dark" asp-area="Administration" asp-controller="Home" asp-action="Atualizar">Voltar</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}