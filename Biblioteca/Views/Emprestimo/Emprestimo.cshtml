@model EmprestimoViewModel

@{
    ViewData["Title"] = "Emprestimo";
}

<a class="btn btn-outline-dark" asp-controller="Home" asp-action="Index">Voltar</a>

<h2>Empréstimo</h2>
<hr />

<div class="container">
    
        @if (Model.Copias is not null && Model.Copias.Count() > 0)
        {
            <partial name="_EmprestimoPartial" model="@Model.Copias" />

            <form asp-controller="Emprestimo" asp-action="Index" method="post" role="form">
                <div class="form-group">
                    <br />
                    <input type="submit" value="Finalizar empréstimo" />
                </div>
            </form>
        }
        else
        {
            <h3>Você ainda não selecionou nenhum livro.</h3>
        }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}