@model IEnumerable<ObraLiteraria>

@{
    ViewData["Title"] = "Pesquisa de obra";
}

<partial name="_AvisosPartial" />

@if(Model is not null && Model.Count() > 0)
{
    <h2>Obras literárias encontradas</h2>
    <hr />

    <div class="row">
        <partial name="_HomePartial" model="@Model" />
    </div>
}
else
{
    <h2>Não foram encontradas obras relacionadas à sua pesquisa.</h2>
}