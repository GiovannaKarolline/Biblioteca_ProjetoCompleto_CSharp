@model ObraLiterariaViewModel

<h2>Pesquisa de Obras</h2>

<section>
    @foreach(ObraLiteraria obra in Model.ObrasLiterarias)
    {
        <div class="card" style="width: 18rem;">
            <img class="card-img-top" src="..." alt="Card image cap">
            <div class="card-body">
                <h5 class="card-title">obra.Titulo</h5>
                <p class="card-text">Livro.</p>
                <a href="#" class="btn btn-primary">Pegar emprestado</a>
            </div>
        </div>
    }
</section>