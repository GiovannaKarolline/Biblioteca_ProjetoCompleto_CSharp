<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Biblioteca</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Biblioteca.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Biblioteca</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse justify-content-end collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Início</a>
                        </li>

                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Administration" asp-controller="Home" asp-action="Index">Administração</a>
                            </li>
                        }

                        @if(!User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Conta" asp-action="Cadastro">Cadastro</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Conta" asp-action="Login">Login</a>
                            </li>
                        }
                    </ul>
                    <form class="d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="PesquisarObra">
                        <input class="form-control mr-sm-2" type="search" placeholder="Encontre o livro que você está procurando..." name="titulo" />
                        <button class="btn btn-outline-success my-2 my-sm-0" type="submit">Pesquisar</button>
                    </form>

                    @if (User.Identity.IsAuthenticated)
                    {
                        <a asp-area="" asp-controller="Emprestimo" asp-action="Index">
                            <img class="btn" src="https://static.thenounproject.com/png/2551-200.png" width="73"/>
                        </a>

                        <a asp-area="" asp-controller="Conta" asp-action="VisualizarPerfil">
                            <img class="btn" src="https://marketplace.canva.com/Wkt1s/MACg40Wkt1s/2/tl/canva-user-profile-icon-MACg40Wkt1s.png" width="70" alt="Perfil de usuário" />
                        </a>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="fixed-bottom border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Biblioteca
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>