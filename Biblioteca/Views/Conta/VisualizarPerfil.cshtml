@model IEnumerable<Emprestimo>

@{
    ViewData["Title"] = "Perfil de usuário";
}

<partial name="_AvisosPartial" />

@if(User.Identity is not null && User.Identity.IsAuthenticated)
{
    <h2>Olá, @(User.Identity.Name)!</h2>
    <hr />

    <br />

    @if(Model is null || Model.Count() < 1 || !Model.Any(emprestimo => emprestimo.DataDevolucao is null))
    {
        <h4>Não há devoluções pendentes.</h4>
    }
    else
    {
       <h4>Prazos de devoluções pendentes:</h4>


        @foreach(Emprestimo emprestimo in Model)
        {
            @if(emprestimo.DataDevolucao is null)
            {
                <h6>• @emprestimo.DataPrevistaDevolucao.ToShortDateString() - <a asp-controller="Emprestimo" asp-action="VisualizarEmprestimos" /><button class="btn btn-primary">Ver empréstimo</button></h6>
            }

        } 
    }
}
else
{
    <h2>Olá! Aqui aparecerá o seu perfil quando estiver logado(a).</h2>
}