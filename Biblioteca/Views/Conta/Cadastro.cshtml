@using Biblioteca.Enums
@model UsuarioViewModel
@{
    ViewData["Title"] = "Cadastro";
}

<partial name="_AvisosPartial" />

<h2>Cadastro</h2>
<br />

<div class="container">
    <form asp-controller="Conta" asp-action="Cadastro" method="post" role="form">

        <div id="divConta">
            <div class="form-group">
                <label asp-for="NomeUsuario">Usuário</label>
                <input class="form-control" type="text" placeholder="Usuário" asp-for="NomeUsuario" />
                <span asp-validation-for="NomeUsuario"></span>
            </div>

            <br />

            <div class="form-group">
                <label asp-for="Email">E-mail</label>
                <input class="form-control" type="text" placeholder="E-mail" asp-for="Email" />
                <span asp-validation-for="Email"></span>
            </div>

            <br />

            <div class="form-group">
                <label asp-for="Senha"></label>
                <input class="form-control" type="password" placeholder="Senha" asp-for="Senha" />
                <span asp-validation-for="Senha"></span>
            </div>

            <br />

            <div class="form-group">
                <label asp-for="DataNascimento"></label>
                <input class="form-control" type="date" placeholder="Data de nascimento" asp-for="DataNascimento" />
                <span asp-validation-for="DataNascimento"></span>
            </div>

            <br />

            <div class="form-group">
                <label asp-for="NumeroTelefone"></label>
                <input class="form-control" type="text" placeholder="Telefone" asp-for="NumeroTelefone" />
                <span asp-validation-for="NumeroTelefone"></span>
            </div>

            <div class="form-group">
                <br />
                <input id="botaoContinuar" class="btn btn-primary" type="button" value="Continuar" />
            </div>

        </div>

        <div id="divEndereco" class="d-none">

            <div class="form-group">
                <fieldset>
                    <label asp-for="@Model.Endereco.TipoLogradouro">Tipo de logradouro: </label>
                    <select class="form-select" asp-for="@Model.Endereco.TipoLogradouro" asp-items="Html.GetEnumSelectList<TipoLogradouro>()">

                        <option value="" disabled>Selecione um tipo de logradouro</option>

                    </select>
                    <span asp-validation-for="Endereco.TipoLogradouro"></span>
                </fieldset>

                <br />

                <div class="form-group">
                    <label asp-for="@Model.Endereco.Logradouro">Logradouro: </label>
                    <input class="form-control" asp-for="@Model.Endereco.Logradouro" type="text" />
                    <span asp-validation-for="Endereco.Logradouro"></span>
                </div>

                <br />

                <div class="form-group">
                    <label asp-for="@Model.Endereco.Numero">Número: </label>
                    <input class="form-control" asp-for="@Model.Endereco.Numero" type="text" />
                    <span asp-validation-for="Endereco.Numero"></span>
                </div>

                <br />

                <div class="form-group">
                    <label asp-for="@Model.Endereco.Complemento">Complemento: </label>
                    <input class="form-control" asp-for="@Model.Endereco.Complemento" />
                    <span asp-validation-for="Endereco.Complemento"></span>
                </div>

                <br />

                <div class="form-group">
                    <label asp-for="@Model.Endereco.Cep">CEP: </label>
                    <input class="form-control" asp-for="@Model.Endereco.Cep" />
                    <span asp-validation-for="Endereco.Cep"></span>
                </div>

            </div>

            <br />

            <div class="form-group d-flex flex-row justify-content-between">
                
                <input id="botaoVoltar" class="btn btn-primary" type="button" value="Voltar" />
                <br />
                <input class="btn btn-primary" type="submit" value="Cadastrar-se" />

            </div>

        </div>

        
    </form>
</div>

<script defer>

    document.addEventListener("DOMContentLoaded", function(){

        if(typeof $.validator !== 'undefined'){

            $.validator.setDefaults({
                ignore: []
            });

        }
    });

    let formConta = document.getElementById('divConta')

    let botaoContinuar = document.getElementById('botaoContinuar')

    let formEndereco = document.getElementById('divEndereco')

    let botaoVoltar = document.getElementById('botaoVoltar')


    botaoContinuar.addEventListener('click', function () {

        formEndereco.classList.remove("d-none");

        formConta.classList.add("d-none");

    })

    botaoVoltar.addEventListener('click', function () {

        formConta.classList.remove("d-none");

        formEndereco.classList.add("d-none");

    })

</script>

@section Scripts{
    <partial name="_ValidationScriptsPartial"/>
}