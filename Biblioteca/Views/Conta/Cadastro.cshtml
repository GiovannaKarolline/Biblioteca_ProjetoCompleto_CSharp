@model UsuarioViewModel
@{
    ViewData["Title"] = "Cadastro";
}

<h2>Cadastro</h2>

<div class="container">
    <form asp-controller="Conta" asp-action="Cadastro" method="post" role="form">
        <div class="form-group">
            <label asp-for="NomeUsuario">Usuário</label>
            <input type="text" placeholder="Usuário" asp-for="NomeUsuario" />
            <span asp-validation-for="NomeUsuario"></span>
        </div>
        <div class="form-group">
            <label asp-for="Email">E-mail</label>
            <input type="text" placeholder="E-mail" asp-for="Email" />
            <span asp-validation-for="Email"></span>
        </div>
        <div class="form-group">
            <label asp-for="Senha"></label>
            <input type="password" placeholder="Senha" asp-for="Senha" />
            <span asp-validation-for="Senha"></span>
        </div>
        <div class="form-group">
            <label asp-for="DataNascimento"></label>
            <input type="date" placeholder="Data de nascimento" asp-for="DataNascimento" />
            <span asp-validation-for="DataNascimento"></span>
        </div>
        <div class="form-group">
            <label asp-for="NumeroTelefone"></label>
            <input type="text" placeholder="Telefone" asp-for="NumeroTelefone" />
            <span asp-validation-for="NumeroTelefone"></span>
        </div>
        <div class="form-group">
            <input type="submit" placeholder="Cadastrar-se" />
        </div>
    </form>
</div>
@section Scripts{
    <partial name="_ValidationScriptsPartial"/>
}