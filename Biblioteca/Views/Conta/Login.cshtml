@model LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<h2>Login</h2>

<div class="container">
    <form asp-controller="Conta" asp-action="Login" method="post" role="form">
        <div class="form-group">
            <label asp-for="NomeUsuario">Usuário</label>
            <input type="text" placeholder="Usuário" asp-for="NomeUsuario" />
            <span asp-validation-for="NomeUsuario"></span>
        </div>
        <div class="form-group">
            <label asp-for="Senha"></label>
            <input type="password" placeholder="Senha" asp-for="Senha" />
            <span asp-validation-for="Senha"></span>
        </div>
        <div class="form-group">
            <input type="submit" placeholder="Logar" />
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}